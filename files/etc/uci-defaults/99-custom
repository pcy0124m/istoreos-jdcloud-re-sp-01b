#!/bin/sh
# ============================================================
# uci-defaults/99-custom：首次开机执行（执行完自动标记完成）
# 目的：只做最小修正（LAN IP / DHCP / 界面语言）。
# 注意：不要重建网络拓扑（桥、device 段），board.d 生成的
#       默认网络配置已被验证可用（initramfs 下有网络），
#       重建逻辑会把配置弄坏导致刷机后无网络。
# ============================================================

# ---------- 1. LAN 接口 IP ----------
# 若 board.d 已生成 lan 接口，直接覆盖 IP/掩码；
# 若不存在则补建（不碰 device 拓扑，假设 br-lan 已存在）
if uci -q get network.lan >/dev/null 2>&1; then
  uci set network.lan.ipaddr='192.168.12.1'
  uci set network.lan.netmask='255.255.255.0'
else
  uci set network.lan='interface'
  uci set network.lan.device='br-lan'
  uci set network.lan.proto='static'
  uci set network.lan.ipaddr='192.168.12.1'
  uci set network.lan.netmask='255.255.255.0'
  uci set network.lan.delegate='0'
fi
uci commit network 2>/dev/null || true

# ---------- 2. DHCP（lan 段 100-199，租期 12h）----------
uci -q set dhcp.lan='dhcp' 2>/dev/null || true
uci -q set dhcp.lan.interface='lan' 2>/dev/null || true
uci -q set dhcp.lan.start='100' 2>/dev/null || true
uci -q set dhcp.lan.limit='100' 2>/dev/null || true
uci -q set dhcp.lan.leasetime='12h' 2>/dev/null || true
uci -q set dhcp.lan.dhcpv4='server' 2>/dev/null || true
uci -q set dhcp.lan.force='1' 2>/dev/null || true
uci -q commit dhcp 2>/dev/null || true

# ---------- 3. 界面语言 ----------
uci -q set luci.main.lang='zh_cn' 2>/dev/null || true
uci -q commit luci 2>/dev/null || true

echo "[99-custom] 最小配置完成（LAN IP=192.168.12.1，root 无密码）"
exit 0
