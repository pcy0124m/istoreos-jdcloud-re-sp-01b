# ============================================================
# iStoreOS 配置种子 - 京东云 RE-SP-01B（MT7621）
#
# 说明：
# 1. 本文件是 .config 的"种子"，OpenWrt 会通过 `make defconfig`
#    自动补全所有未指定的选项。因此只需列出"明确要启用/禁用"的项。
# 2. 设备名 jdcloud_re-sp-01b 来自 OpenWrt 上游设备树
#    （target/linux/ramips/dts/mt7621_jdcloud_re-sp-01b.dts）。
#    若 iStoreOS 某分支未包含该设备，请改用其支持的设备名，
#    或在 menuconfig 中查找。
# 3. 想关闭某包，使用 =n；想强制开启，使用 =y。
# 4. 注意：wsdd2 依赖有问题已移除 samba4；
#    diffutils 依赖 libpcre2 有问题已移除；
#    递归依赖的 wireguard/rpcd/prometheus 相关包已禁用。
# ============================================================

# ---- 目标平台（必填）----
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_jdcloud_re-sp-01b=y

# ---- iStoreOS 核心组件 ----
# 应用商店 / 快速启动向导
CONFIG_PACKAGE_istore=y
CONFIG_PACKAGE_luci-app-istore=y
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_luci-app-quickstart=y
# iStoreOS 首页（如源码包含该包则生效）
CONFIG_PACKAGE_istorex=y
CONFIG_PACKAGE_luci-app-istorex=y

# ---- LuCI 基础界面 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-theme-material=y

# ---- 常用 LuCI 应用 ----
# 网络与防火墙
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-network=y
CONFIG_PACKAGE_luci-app-ttyd=y
# 系统管理
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-watchcat=y
# 文件共享（samba4 依赖 wsdd2 构建失败，改用 vsftpd）
# CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-vsftpd=y
CONFIG_PACKAGE_luci-app-aria2=y
# 路由与代理（按需开启）
# CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-app-ssr-plus=y
# CONFIG_PACKAGE_luci-app-openclash=y

# ---- DNS / DHCP ----
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_smartdns=y

# ---- 文件系统支持 ----
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# ---- USB 支持（如需外接 U 盘/移动硬盘）----
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y

# ---- 常用系统工具 ----
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-stat=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tcpdump=y
# diffutils 依赖 libpcre2 缺失，改用基础工具
# CONFIG_PACKAGE_diffutils=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_zip=y
CONFIG_PACKAGE_openssh-sftp-server=y

# ---- IPv6 ----
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_ip6tables=n

# ---- 禁用可能引发递归依赖的包 ----
# wireguard 相关包会引入 rpcd 递归依赖
CONFIG_PACKAGE_luci-app-wireguard=n
CONFIG_PACKAGE_rpcd-mod-wireguard=n
# prometheus 相关也有递归依赖
CONFIG_PACKAGE_prometheus-node-exporter-ucode-wireguard=n
# zabbix/zsh 依赖 libpcre2（缺失）
CONFIG_PACKAGE_zabbix=n
CONFIG_PACKAGE_zsh=n

# ---- 关闭调试以减小体积 ----
CONFIG_PACKAGE_gdb=n
CONFIG_PACKAGE_strace=n
