+  BLOCKSIZE := 256k
+  PAGESIZE := 4096
+  DEVICE_VENDOR := JDCloud
+  DEVICE_MODEL := RE-SP-01B
+  SUPPORTED_DEVICES += jdcloud,re-sp-01b re-sp-01b
+  DEVICE_PACKAGES := kmod-mt7603 kmod-mt7615-firmware \
+	kmod-mmc-mtk kmod-usb3
+endef
+TARGET_DEVICES += jdcloud_re-sp-01b
